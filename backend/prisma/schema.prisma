generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma-client"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique(map: "Brand_name_key") @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  product   product[]
}

model category {
  id             Int        @id @default(autoincrement())
  name           String     @db.VarChar(100)
  slug           String     @unique(map: "Category_slug_key") @db.VarChar(120)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  parentId       Int?
  category       category?  @relation("categoryTocategory", fields: [parentId], references: [id], map: "Category_parentId_fkey")
  other_category category[] @relation("categoryTocategory")
  product        product[]

  @@unique([parentId, name], map: "Category_parentId_name_key")
}

model order {
  id                     Int         @id @default(autoincrement())
  orderNumber            String      @unique(map: "Order_orderNumber_key") @db.VarChar(40)
  customerName           String      @db.VarChar(100)
  email                  String      @db.VarChar(254)
  phone                  String      @db.VarChar(20)
  address                String      @db.VarChar(500)
  city                   String      @db.VarChar(100)
  postalCode             String?     @db.VarChar(20)
  subtotal               Decimal     @db.Decimal(10, 2)
  deliveryCharge         Decimal     @default(0.00) @db.Decimal(10, 2)
  total                  Decimal     @db.Decimal(10, 2)
  paymentMethod          String      @default("COD") @db.VarChar(20)
  paymentStatus          String      @default("PENDING") @db.VarChar(20)
  status                 String      @default("PENDING") @db.VarChar(30)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime
  userId                 Int?
  idempotencyKey         String?     @unique(map: "Order_idempotencyKey_key") @db.VarChar(64)
  idempotencyRequestHash String?     @db.Char(64)
  user                   user?       @relation(fields: [userId], references: [id], onDelete: Restrict, map: "Order_userId_fkey")
  orderitem              orderitem[]

  @@index([createdAt], map: "Order_createdAt_idx")
  @@index([email], map: "Order_email_idx")
  @@index([status], map: "Order_status_idx")
  @@index([userId], map: "Order_userId_fkey")
}

model orderitem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String   @db.VarChar(200)
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       order    @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product     product  @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([orderId], map: "OrderItem_orderId_idx")
  @@index([productId], map: "OrderItem_productId_idx")
}

model product {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(200)
  description   String?     @db.Text
  price         Decimal     @db.Decimal(10, 2)
  rating        Decimal?    @db.Decimal(2, 1)
  imageUrl      String?     @db.VarChar(500)
  stock         Int         @default(0)
  isActive      Boolean     @default(true)
  categoryId    Int
  brandId       Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  featured      Boolean     @default(false)
  onSale        Boolean     @default(false)
  originalPrice Decimal?    @db.Decimal(10, 2)
  orderitem     orderitem[]
  brand         brand       @relation(fields: [brandId], references: [id], map: "Product_brandId_fkey")
  category      category    @relation(fields: [categoryId], references: [id], map: "Product_categoryId_fkey")

  @@index([brandId], map: "Product_brandId_idx")
  @@index([categoryId], map: "Product_categoryId_idx")
  @@index([featured], map: "Product_featured_idx")
  @@index([isActive], map: "Product_isActive_idx")
  @@index([onSale], map: "Product_onSale_idx")
}

model session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique(map: "Session_tokenHash_key") @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([expiresAt], map: "Session_expiresAt_idx")
  @@index([userId], map: "Session_userId_idx")
}

model user {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  email        String    @unique(map: "User_email_key") @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  role         String    @default("CUSTOMER") @db.VarChar(20)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  order        order[]
  session      session[]

  @@index([isActive], map: "User_isActive_idx")
  @@index([role], map: "User_role_idx")
}
