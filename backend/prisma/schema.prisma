// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma-cjs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  rating      Decimal? @db.Decimal(2, 1)
  imageUrl    String?  @db.VarChar(500)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)

  categoryId  Int
  brandId     Int

  category    Category @relation(fields: [categoryId], references: [id])
  brand       Brand    @relation(fields: [brandId], references: [id])
  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}
model Order {
  id                     Int      @id @default(autoincrement())
  orderNumber            String   @unique @db.VarChar(40)
  idempotencyKey         String?  @unique @db.VarChar(64)
  idempotencyRequestHash String?  @db.Char(64)

  // Connect this order to a customer account
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  customerName    String      @db.VarChar(100)
  email           String      @db.VarChar(254)
  phone           String      @db.VarChar(20)

  address         String      @db.VarChar(500)
  city            String      @db.VarChar(100)
  postalCode      String?     @db.VarChar(20)

  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryCharge  Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)

  paymentMethod   String      @default("COD") @db.VarChar(20)
  paymentStatus   String      @default("PENDING") @db.VarChar(20)
  status          String      @default("PENDING") @db.VarChar(30)

  items           OrderItem[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              Int      @id @default(autoincrement())

  orderId         Int
  productId       Int

  productName     String   @db.VarChar(200)
  unitPrice       Decimal  @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal  @db.Decimal(10, 2)

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  role         String    @default("CUSTOMER") @db.VarChar(20)
  isActive     Boolean   @default(true)

  sessions     Session[]
  orders       Order[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}